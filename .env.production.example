# Copy to .env.production and fill in values (never commit .env.production):
#   cp .env.production.example .env.production

DEBUG=False
SECRET=change-me-run-openssl-rand-hex-32
TZ=America/New_York
ALLOWED_HOSTS=*
ADMIN_ENABLED=True
REGISTRATION=True
MUSIC_ENABLED=True
MUSICBRAINZ_CONTACT=github@fuzzygrim.com
MUSIC_DEFAULT_MARKET=US
# Optional but strongly recommended for popularity-ranked music search.
LISTENBRAINZ_TOKEN=

DB_HOST=db
DB_NAME=spine
DB_USER=spine
DB_PASSWORD=change-me-run-openssl-rand-hex-32
DB_PORT=5432

REDIS_URL=redis://redis:6379

# Web request concurrency (2 processes x 4 threads by default)
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Minimum for movie/TV search — get a key at https://www.themoviedb.org/settings/api
TMDB_API=

# Optional licensed IMDb API via AWS Data Exchange. Configure AWS credentials
# with an instance role or the standard AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY environment variables.
# IMDB_API_KEY=
# IMDB_DATA_SET_ID=
# IMDB_REVISION_ID=
# IMDB_ASSET_ID=
# IMDB_AWS_REGION=us-east-1

# Optional — add when you need these media types
# IGDB_ID=
# IGDB_SECRET=
# MAL_API=

# Required for the official NYT Best Sellers featured lists.
NYT_BOOKS_API_KEY=
