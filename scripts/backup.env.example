# =============================================================================
# Spine backup settings
# =============================================================================
#
# Copy this file to ~/.config/spine/backup.env and edit the COPY:
#
#   mkdir -p ~/.config/spine
#   cp scripts/backup.env.example ~/.config/spine/backup.env
#   chmod 600 ~/.config/spine/backup.env
#
# Never put the real file inside the git repository: the healthchecks.io URL
# below works like a password, and the scripts warn you when the file is readable
# by other users. (Cloudflare R2 credentials are not stored here at all - they
# live in rclone's own config file, ~/.config/rclone/rclone.conf, which
# `rclone config` creates.)
#
# The file is plain shell: NAME="value", no spaces around the "=". Lines that
# start with # are comments. Every setting is optional. With an empty file the
# backup still runs and simply skips R2 and healthchecks.io ("SKIP" in the log).
#
# Settings already present in the environment win over this file, so a one-off
# run is easy:   KEEP_DB_DUMPS=30 ~/.local/share/spine-backup/backup-production.sh
#
# Numbers must be short whole numbers without leading zeros (a very long one is
# refused, because it could overflow and delete more than intended; "08" is
# refused because the shell would read it as a broken octal number).
#
# Full walkthrough: docs/backups.md

# --- Off-site copy to Cloudflare R2 (uploaded with rclone) --------------------
# Fill in BOTH lines to switch it on; leave BOTH empty to skip the upload.

# The name you gave the remote in `rclone config` (docs/backups.md suggests: r2)
RCLONE_REMOTE=""

# The name of your R2 bucket (docs/backups.md suggests: spine-backups)
R2_BUCKET=""

# Folders inside the bucket. Nightly files land in <bucket>/<R2_PREFIX>/, the
# monthly copies in <bucket>/<R2_MONTHLY_PREFIX>/ (give them different R2
# lifecycle rules: see docs/backups.md, Step 4).
#R2_PREFIX="nightly"
#R2_MONTHLY_PREFIX="monthly"

# Set to 1 once the upload works: a run that ends without a verified off-site
# copy (R2 not configured, rclone missing, ...) then counts as FAILED instead of
# a quiet "SKIP".
#REQUIRE_OFFSITE=1

# --- Monitoring with healthchecks.io ------------------------------------------
# The ping URL of your check, e.g. https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# The script pings it when a backup starts, when it succeeds (with a one-line
# summary) and, with a log excerpt, when it fails. Leave empty to skip.
HEALTHCHECK_URL=""

# --- Local copies -------------------------------------------------------------
# Where backups are kept. Nightly files go into its "nightly" sub-folder and the
# monthly copies into "monthly". (The deploy workflow's pre-deploy dumps, once
# that workflow is merged, use the same folder.)
#BACKUP_ROOT="$HOME/projects/spine-backups"

# How many nightly files to keep (the newest N of each kind; older ones are
# deleted, but only after a fully successful run and the off-site upload).
#KEEP_DB_DUMPS=14
#KEEP_MEDIA_ARCHIVES=14

# How many monthly copies to keep locally (the first good backup of each month).
# 0 turns monthly copies off.
#KEEP_MONTHLY=3

# --- "Valid but useless" backups ----------------------------------------------
# A backup that is a valid file but looks wrong is KEPT, yet the run is reported
# as failed (and nothing is pruned), so that somebody looks:
#   - fewer than MIN_USERS rows in users_user (0 turns the check off)
#MIN_USERS=1
#   - a dump more than this many percent smaller than the BIGGEST of the newest
#     SIZE_BASELINE_DUMPS healthy nightly dumps and the newest monthly one (0 = off).
#     Dumps that were flagged themselves never count as the yardstick, so a bad
#     night cannot make the next bad night look normal.
#MAX_SIZE_DROP_PERCENT=50
#SIZE_BASELINE_DUMPS=7
#     If you deleted data ON PURPOSE the database really is smaller now. Tell the
#     backup once, on the command line (this setting is ignored in this file, so
#     it cannot be left switched on by accident):
#         ACCEPT_SMALLER_DB=1 ~/.local/share/spine-backup/backup-production.sh
#     That run skips the size check, and its dump becomes the new yardstick.
#   - a media archive with nothing in it (set 1 if the volume is meant to be empty)
#ALLOW_EMPTY_MEDIA=0

# --- Advanced: only change these if your setup differs from -------------------
# --- docker-compose.production.yml --------------------------------------------
#DB_CONTAINER="spine-db"
#APP_CONTAINER="spine"
#DB_NAME="spine"
#DB_USER="spine"

# Where the app container mounts the media volume. The volume itself is found
# from the container's mounts, its name is never hard-coded.
#MEDIA_MOUNT_PATH="/yamtrack/media"

# Image used for the throwaway container that archives the media volume.
# Default: the same image as the database container (already on the machine).
#MEDIA_HELPER_IMAGE=""

#NIGHTLY_SUBDIR="nightly"
#MONTHLY_SUBDIR="monthly"

# Seconds to wait for Docker Desktop, and then for the database, to be ready
# (useful right after a reboot).
#DOCKER_WAIT_SECONDS=60

# Time limits. Docker Desktop can hang; nothing is allowed to wait forever.
#   each quick docker call:                              DOCKER_CMD_TIMEOUT
#   each long step (dump, verification, archive, upload): STEP_TIMEOUT_SECONDS
#   the whole run:                                       MAX_RUN_SECONDS
# If your database has grown so much that the backup legitimately takes longer
# (the log says "timed out after 3600s"), raise STEP_TIMEOUT_SECONDS, and
# MAX_RUN_SECONDS with it: the whole-run limit should be bigger than the limit of
# any single step (and of the steps that run after it), or it ends the run first.
#DOCKER_CMD_TIMEOUT=30
#STEP_TIMEOUT_SECONDS=3600
#MAX_RUN_SECONDS=10800

# pg_dump starts by taking a share lock on every table. If a migration (or some
# long job) holds a conflicting lock, pg_dump waits for it - this long at most,
# and then gives up with a clear error instead of waiting as long as the lock lasts.
#DUMP_LOCK_WAIT_SECONDS=120

# Free disk space needed is the LARGER of this many MB and twice the size of the
# last backup (dump + media archive).
#MIN_FREE_MB=1024

# restore-check.sh: fail if the newest dump is older than this many hours.
#RESTORE_CHECK_MAX_AGE_HOURS=36

# restore-check.sh restores into a disposable Postgres container. By default it
# uses the same image as the database container; the container stops itself
# after this many seconds even if the script is killed.
#RESTORE_CHECK_IMAGE=""
#RESTORE_CONTAINER_MAX_SECONDS=4200

# ... and with limits, so that a runaway restore cannot starve production (they
# share Docker): memory (e.g. 512m, 2g), number of CPUs, number of processes.
#RESTORE_CONTAINER_MEMORY=2g
#RESTORE_CONTAINER_CPUS=2
#RESTORE_CONTAINER_PIDS=256

# The check refuses to start unless Docker has room for the restored copy: the
# larger of this many MB and 5 times the dump's size plus 512 MB.
#RESTORE_MIN_FREE_MB=2048

# Extra folders (colon-separated) searched first for docker and rclone, if you
# installed them somewhere unusual. The scripts already look in Homebrew's and
# Docker Desktop's normal locations.
#EXTRA_PATH=""
